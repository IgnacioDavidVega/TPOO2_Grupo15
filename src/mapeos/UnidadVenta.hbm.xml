<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.UnidadVenta" table="UnidadVenta">
        <id name="idUnidadVenta" column="idUnidadVenta">
            <generator class="identity"/>
        </id>
        
        <property name="nombreComercial" column="nombreComercial" type="string"/>
        <property name="superficie" column="superficie" type="long"/>
        <property name="codigoUnico" column="codigoUnico" type="string" unique="true"/>
        <many-to-one name="festival" class="datos.Festival" column="idFestival" not-null="true"/>
        <many-to-one name="responsableCargo" class="datos.Personal" column="idResponsableCargo"/>
        
        <set name="platos" table="plato" order-by="idPlato asc" inverse="true" lazy="true" fetch="select">
        	<key column="idUnidadVenta" />
        	<one-to-many class="datos.Plato" />
		</set>
		
		<set name="pedidos" table="pedido" order-by="idPedido asc" inverse="true" lazy="true" fetch="select">
        	<key column="idUnidadVenta" />
        	<one-to-many class="datos.Pedido" />
		</set>
		
		<set name="personal" table="personal" order-by="idPersonal asc" inverse="true" lazy="true" fetch="select">
        	<key column="idUnidadVenta" />
        	<one-to-many class="datos.Personal" />
		</set>

        <joined-subclass name="datos.FoodTruck" table="foodTruck">
            <key column="idUnidadVenta"/>
            <property name="patente" column="patente" type="string"/>
            <property name="conexionElectrica" column="conexionElectrica" type="boolean"/>
        </joined-subclass>

        <joined-subclass name="datos.PuestoDesarmable" table="puestoDesarmable">
            <key column="idUnidadVenta"/>
            <property name="cantidadCarpas" column="cantidadCarpas" type="long"/>
            <property name="tiempoMontaje" column="tiempoMontaje" type="long"/>
        </joined-subclass>
        
    </class>
</hibernate-mapping>